# Copy to backend/.env. Loaded as plain key=value data; process environment takes precedence.
# Never use the original online credentials in a shared/demo environment.
# Official DeepSeek API defaults verified 2026-09-26.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_THINKING=disabled
DATA_AGENT_API_TOKEN=
META_DB_HOST=127.0.0.1
META_DB_PORT=13306
META_DB_USER=metadata_owner
META_DB_PASSWORD=
META_DB_NAME=meta
DW_DB_HOST=127.0.0.1
DW_DB_PORT=13306
DW_DB_USER=qa_readonly
DW_DB_PASSWORD=
DW_DB_NAME=dw
QDRANT_HOST=127.0.0.1
QDRANT_PORT=16333
EMBEDDING_SIZE=1024
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=18080
EMBEDDING_MODEL=bge-large-zh-v1.5
ES_HOST=127.0.0.1
ES_PORT=19200
ES_INDEX=column_values
